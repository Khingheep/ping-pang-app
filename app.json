{
  "expo": {
    "name": "Ping Pang Paris",
    "slug": "ping-pang-paris",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pingpangparis",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F6F3",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "paris.pingpang.app"
    },
    "android": {
      "package": "paris.pingpang.app",
      "adaptiveIcon": {
        "backgroundColor": "#092C25",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ping Pang utilise ta position pour trouver des joueurs et des tables près de toi."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F6F3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#092C25"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ping Pang accède à tes photos pour choisir ton avatar.",
          "cameraPermission": "Ping Pang utilise la caméra pour prendre ta photo de profil."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "866c2335-f3f0-4774-b0dc-7fa7028f2e9f"
      }
    },
    "owner": "walid92z"
  }
}
