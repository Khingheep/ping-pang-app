# Ping Pang Paris — variables d'environnement (Expo)
# Copie ce fichier vers .env et renseigne les valeurs du projet Supabase.
# Les variables exposées au client DOIVENT être préfixées EXPO_PUBLIC_.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optionnel : recherche de GIFs dans le chat (clé gratuite : https://developers.giphy.com)
EXPO_PUBLIC_GIPHY_KEY=YOUR-GIPHY-KEY
