{
  "cli": {
    "version": ">= 20.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "beta": {
      "extends": "production",
      "env": {
        "APP_VARIANT": "beta"
      }
    }
  },
  "submit": {
    "production": {},
    "beta": {
      "ios": {
        "ascAppId": "6790777316"
      }
    }
  }
}
